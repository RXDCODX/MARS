# Microservices secrets
secrets/

# Docker
.docker/

# Environment variables with real credentials.
# Шаблоны окружений (`.env.development.example`, `.env.production.example` и
# `.env.example`) IS tracked и секретов не содержит, реальные файлы (`.env`,
# `.env.<среда>`) — NOT: в них токены и пароли стенда.
# Правило на `.env.*` широкое, а не перечисление: новое окружение, добавленное
# без правки этого блока, молча уедет в коммит целиком.
.env
.env.*
!.env.*.example

# Шаблон без среды остаётся в репозитории: `.env.*` ловит и его, а
# `!.env.*.example` его не возвращает — там нужен суффикс `.example` после имени
# среды. Без этой строки удаление `.env.example` из индекса было бы необратимым,
# и `git add` его больше не поднял бы.
!.env.example

# Local tool state (not configuration)
.compose/

# ─── Monolith leftovers ──────────────────────────────────────────────────────
# This repository holds only the microservices. The rules below came from the
# old combined layout and no longer match anything, but they are kept so that
# copying a secret back in from MARS.Old does not leak it.
MARS.Projects/MARS.Server/wwwroot/
/MARS/MARS.Server/appsettings.json
/MARS/MARS.Server/appsettings.Production.json
MARS.Projects/MARS.AutoTests/
MARS.Projects/mars.client/
MARS.Projects/MARS.AudioController/
Sql_backup/

# ─── Coverage (ReportGenerator, .github/scripts/coverage-gate.py) ────────────
# Локальные отчёты покрытия — артефакт сборки, как и TestResults выше.
coverage-report/
coverage.xml
# Каталог локального прогона .github/scripts/coverage-local.ps1: отчёты по
# проектам, слитый Cobertura.xml и HTML. Содержимое воспроизводимо командой,
# хранить его в git незачем, а пути внутри Cobertura.xml абсолютные и утекуют
# на машину автора.
coverage-local/
coverage-local-run.log

# ─── Storage UI (ClientApp) ─────────────────────────────────────────────────
# node_modules восстанавливается через npm ci, а ui-dist собирается Vite
# внутри образа: хранить артефакты сборки в репозитории незачем.
src/MARS.MediaStorage/ClientApp/node_modules/
src/MARS.MediaStorage/ui-dist/
# Кэш инкрементальной сборки TypeScript: содержит абсолютные пути и хеши,
# пересоздаётся при каждом tsc и в git не должен попадать.
*.tsbuildinfo

# ─── Клиент MARS.Gateway (ClientApp) ────────────────────────────────────────
# Отдельный фронтенд оверлеев, админки и сайта. Раздаётся контейнером
# client-ui (nginx), наружу опубликован только Gateway.
src/MARS.Gateway/ClientApp/node_modules/
# Артефакты сборки: dist отдаёт nginx, storybook-static нигде не нужен.
src/MARS.Gateway/ClientApp/dist/
src/MARS.Gateway/ClientApp/storybook-static/
src/MARS.Gateway/ClientApp/coverage/
# Состояние установки Yarn Berry: пересоздаётся при install и содержит пути
# машины. Сам Yarn (yarn-4.18.0.cjs) в репозитории остаётся — им закреплён
# менеджер пакетов.
src/MARS.Gateway/ClientApp/.yarn/install-state.gz
# Логи и дампы инструментов: генерируются локально.
src/MARS.Gateway/ClientApp/test-output.log
