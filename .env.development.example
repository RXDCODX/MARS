# ─────────────────────────────────────────────────────────────────────────────
# MARS — переменные окружения для РАЗРАБОТКИ. Шаблон, лежит в репозитории.
#
# Стенд запускается с `docker-compose.dev.yml`, где ASPNETCORE_ENVIRONMENT=Development,
# то есть сервисы читают appsettings.Development.json. Секреты окружения для этой
# среды лежат в `.env.development`, а compose получает его флагом:
#
#     cp .env.development.example .env.development
#     docker compose --env-file .env.development \
#         -f docker-compose.yml -f docker-compose.dev.yml up -d --wait
#
# Скрипты делают это сами и по тому же переключателю `-Dev`:
#
#     .\scripts\windows\stack.ps1 -Action Up -Dev
#
# Для боевого стенда — `.env.production` и `.env.production.example`. Файл `.env`
# больше не используется: compose читал его сам, и рядом с двумя именованными
# файлами он стал бы третьим источником правды. Набор ключей в обоих шаблонах
# обязан совпадать — это проверяет тест в MARS.Gateway.Tests.
#
# ─────────────────────────────────────────────────────────────────────────────

# ─── Хостовые порты стенда ────────────────────────────────────────────────────
# Порты, опубликованные на хост, нарезаются от одного базового:
# MARS_PORT_<СЕРВИС> = MARS_PORT_BASE + порядковый номер. Арифметики compose не
# умеет, поэтому значения перечислены явно, а «базовый + номер» проверяет тест
# MARS.Gateway.Tests (PortAllocationTests): сдвиг стенда — это правка одной
# строки MARS_PORT_BASE, а не тридцати портов в двух файлах.
#
# Стенд разработки берёт базу 6001 (порты 6001…6032), боевой — 7001 (7001…7032):
# так оба стенда поднимаются на одной машине одновременно.
MARS_PORT_BASE=6001

# Приложение (в бою наружу выходят Gateway и прокси Telegram, см. docker-compose.yml).
MARS_PORT_GATEWAY=6001
MARS_PORT_TWITCH_CORE=6002
MARS_PORT_WAIFU_GACHA=6003
MARS_PORT_TELEGRAM=6004
MARS_PORT_DISCORD=6005
MARS_PORT_COMMANDS=6006
MARS_PORT_SOUND_REQUEST=6007
MARS_PORT_TTS=6008
MARS_PORT_OBS=6009
MARS_PORT_ALERTS=6010
MARS_PORT_SCOREBOARD=6011
MARS_PORT_CINEMA_QUEUE=6012
MARS_PORT_MEDIA_STORAGE=6013
MARS_PORT_ADMIN=6014
MARS_PORT_VIDEOS365=6015
MARS_PORT_SHIKIMORI=6016

# Инфраструктура: публикуется только на dev-стенде.
MARS_PORT_POSTGRES=6017
MARS_PORT_RABBITMQ=6018
MARS_PORT_RABBITMQ_MANAGEMENT=6019
MARS_PORT_TEMPO_HTTP=6020
MARS_PORT_TEMPO_OTLP_GRPC=6021
MARS_PORT_TEMPO_OTLP_HTTP=6022
MARS_PORT_PROMETHEUS=6023
MARS_PORT_GRAFANA=6024
MARS_PORT_LOKI=6025
MARS_PORT_ALLOY=6026
# Вторые хостовые порты сервисов с gRPC и публикация matoi. Строки добавлены
# в конец блока намеренно: порядок строк — это нумерация схемы, и вставка в
# середину сдвинула бы порты уже работающего стенда. Нужны только стенду
# разработки: наружу боевого стенда выходит единственный Gateway, а gRPC не
# публикуется нигде.
MARS_PORT_MATOI=6027
MARS_PORT_ALERTS_GRPC=6028
MARS_PORT_OBS_GRPC=6029
MARS_PORT_SCOREBOARD_GRPC=6030
MARS_PORT_SOUND_REQUEST_GRPC=6031
MARS_PORT_TTS_GRPC=6032
MARS_PORT_TELEGRAM_GRPC=6033
# Второй порт Alloy — приёмник OTLP-логов (внутри контейнера 4317, тот же, что
# у Tempo). Нужен стенду разработки: приложение на хосте шлёт логи на localhost,
# а общий с Tempo ключ занял бы один хост-порт дважды.
MARS_PORT_ALLOY_OTLP=6034

# ─── PostgreSQL: суперпользователь ───────────────────────────────────────────
# Учётные данные контейнера postgres. Ими владеет только сам сервис БД:
# ни один сервис MARS к ним не подключается (в строке подключения у сервисов
# стоят роли из следующего блока).
POSTGRES_USER=mars
POSTGRES_PASSWORD=mars
POSTGRES_DB=mars

# ─── PostgreSQL: базы и роли сервисов ─────────────────────────────────────────
# На каждый сервис — своя база и своя роль с таким же именем. Роль владеет
# базой (EF Core создаёт схемы и таблицы при применении миграций), а доступ
# к базе для всех прочих ролей закрыт через REVOKE CONNECT ... FROM PUBLIC
# в infrastructure/db-init/01-databases.sh.
#
# Скрипт инициализации отказывается работать, если хотя бы один пароль пуст,
# поэтому оставьте здесь dev-значения только для локального запуска, а в проде
# замените каждую строку.
#
# ВНИМАНИЕ: эти значения попадают в строки подключения сервисов и потому
# видны в `docker inspect` и в `docker compose config`. Для боевого развёртывания
# замените механизм на docker secrets (см. secrets/README.md) — в коде уже есть
# поддержка Password_FILE=.
MARS_TWITCH_PASSWORD=mars
MARS_WAIFU_PASSWORD=mars
MARS_CHAT_PASSWORD=mars
MARS_MEDIA_PASSWORD=mars
MARS_SCOREBOARD_PASSWORD=mars
MARS_CINEMA_PASSWORD=mars
MARS_MEDIASTORAGE_PASSWORD=mars
# Собственная БД MARS.Shikimori (клиент Shikimori и его рейт-лимитер)
MARS_SHIKIMORI_PASSWORD=mars
# Реквизиты приложения Shikimori API (https://shikimori.one/api/doc)
SHIKIMORI_CLIENT_NAME=
SHIKIMORI_CLIENT_ID=
SHIKIMORI_CLIENT_SECRET=
SHIKIMORI_SITE=https://shikimori.one
MARS_ADMIN_PASSWORD=mars
MARS_ALERTS_PASSWORD=mars
MARS_VIDEOS365_PASSWORD=mars

# ─── MARS.AudioController (Windows-хост, вне Docker) ─────────────────────────
# Адрес сервиса управления громкостью микрофона и микшером приложений.
# Запускается вручную на хосте докера, в docker-compose не входит.
# Контейнеры достают его по host.docker.internal (extra_hosts в compose).
AUDIO_CONTROLLER_URL=http://host.docker.internal:30695

# ─── Конвейер 365 (MARS.Videos365) ───────────────────────────────────────────
# Учётные данные сайта-источника и канал назначения. Пустая конфигурация
# допустима: воркер пишет предупреждение и не запускается. Заполнять нужно
# все четыре значения одновременно — частичная конфигурация также
# отключает воркер.
CONFIG365_SITE=
CONFIG365_LOGIN=
CONFIG365_PASSWORD=
CONFIG365_TELEGRAM_CHANNEL_ID=0

# ─── Уведомления администраторам (Telegram) ───────────────────────────────────
# Токен бота и список чатов, которым сервисы сообщают о проблемах.
# Пустое значение допустимо: сервис стартует, а уведомление пропускается с
# предупреждением в логе (см. SiteUnavailableNotifier в MARS.Videos365).
# Несколько адресатов задаются индексом в имени переменной:
# Telegram:AdminIds:0 → TELEGRAM_ADMIN_ID, :1 → TELEGRAM_ADMIN_ID_2 и так далее.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
# Учётные данные брокера. ВАЖНО: не оставляйте guest/guest — RabbitMQ по
# умолчанию пускает guest только с loopback, и все межсервисные соединения
# падают с ACCESS_REFUSED.
RABBITMQ_USER=mars
RABBITMQ_PASSWORD=mars

# ─── Matoi (шлюз к booru) ─────────────────────────────────────────────────────
# Ключ авторизации matoi. Передаётся потребителями как `Authorization: Bearer`.
# ВАЖНО: пустое значение небезопасно — matoi проверяет configuredKey == "" и при
# пустом ключе НЕ включает авторизацию вовсе, то есть /api/* становится открытым
# всему, кто дотянется до контейнера.
MATOI_API_KEY=mars-dev-matoi-key
# Пароль встроенного кэша matoi. В образе он зашит в CMD (--requirepass matoi),
# поэтому compose переопределяет command этим значением. matoi ходит в кэш по
# URL `redis://:<пароль>@matoi-redis:6379`, и без совпадения с command кэш не
# поднимется, а matoi завершится с кодом 1.
MATOI_REDIS_PASSWORD=matoi
# Провайдер по умолчанию, когда ввод награды не содержит `provider:`.
MATOI_DEFAULT_PROVIDER=danbooru
# Ключи booru-источников. Пустые значения допустимы: danbouru отдаёт анонимную
# выдачу (проверено — работает), а rule34 без них не работает вовсе: его DAPI
# требует аутентификации. Источники без учётных данных отдают 502, и matoi
# пробрасывает это как 502 наружу, а не как пустую выдачу.
DANBOORU_API_ID=
DANBOORU_API_KEY=
RULE34_API_ID=
RULE34_API_KEY=

# ─── Внутренняя аутентификация сервисов ──────────────────────────────────────
# Общий ключ для межсервисного обмена (Gateway ⇄ сервисы, сервис ⇄ сервис).
# Передаётся как заголовок `X-Api-Key`.
# В проде обязательно замените: ключ защищает admin-API (dump root_state,
# запись environment-переменных, проверка произвольных путей ФС).
SERVICE_API_KEY=mars-dev-service-key

# ─── Observability ───────────────────────────────────────────────────────────
# Grafana — единственный UI для метрик (Prometheus), логов (Loki) и трейсов
# (Tempo). Пароль администратора Grafana. Сам UI выходит наружу на
# MARS_PORT_GRAFANA (6024 при базе 6001), а не на 3000: внутри сети она слушает
# 3000, а хостовый порт берётся из общей схемы портов.
GRAFANA_PASSWORD=mars
# Application Insights. Пустое значение отключает отправку телеметрии.
APPINSIGHTS_CONNECTION_STRING=
# Логи приложений шлют сами сервисы по OTLP в Alloy, который раскладывает их в
# Loki; stdout инфраструктуры Alloy читает из Docker-демона. Отдельных секретов и
# переменных для этого не требуется. Раньше здесь был SEQ_ADMIN_PASSWORD: Seq
# выпилен, логи смотрятся в Grafana (Explore → Loki).

# ─── Twitch API ──────────────────────────────────────────────────────────────
# Токены приложения: https://dev.twitch.tv/console/apps
# Пустые значения допустимы: сервис стартует и работает, но подключение к чату
# откладывается с явным предупреждением в логе.
TWITCH_CLIENT_ID=
TWITCH_SECRET=
# OAuth-токен бота: Bearer-токен с oauth:chat, oauth:read, user:read:email
TWITCH_OAUTH=
# Первый токен для Twitch API. Пока таблица twitch.TwitchToken пуста, сервис берёт
# его отсюда и кладёт в базу сам — вносить токен в базу руками не нужно.
# Refresh-токен необязателен: он нужен только чтобы продлить доступ, когда задан
# и TWITCH_ACCESS_TOKEN_EXPIRES_IN. Без срока токен считается бессрочным.
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_ACCESS_TOKEN_EXPIRES_IN=
# Куда Twitch возвращает код авторизации: внешний адрес Gateway плюс путь
# обработчика. Обязателен для стенда — внутри контейнера адрес сервиса браузеру
# недоступен, и ссылка авторизации ушла бы в никуда. Например:
#   http://localhost:7001/api/TwitchAuth/user-auth
TWITCH_AUTH_REDIRECT_URI=
TWITCH_AUTH_REQUEST_INTERVAL=1.00:00:00

# ─── WTelegram (MARS.Alerts) ──────────────────────────────────────────────────
# Единственное legacy-значение, у которого в новых схемах нет места: таблица
# WTelegramAlloweedChannels переносится в раздел WTelegram → AllowedChannelIds
# (MARS.Alerts/Configuration/WTelegramConfiguration.cs). Миграция
# 20260930192816_SeedLegacyChat удаляет таблицу из staging, поэтому список
# разрешённых каналов обязан быть задан здесь — иначе WTelegram перестанет
# читать канал после переезда.
#
# Индекс в имени переменной соответствует позиции элемента массива:
# WTelegram:AllowedChannelIds:0 → WTelegram__AllowedChannelIds__0.
# Значение перенесено из legacy-таблицы; замените, если канал сменился.
WTELGRAM_ALLOWED_CHANNEL_IDS=-1001148195583

# ─── Git-синхронизация хранилища (MARS.MediaStorage) ─────────────────────────
# Каталог wwwroot версионируется в внешнем git-репозитории: загрузка,
# перемещение и удаление файла порождают коммит.
# По умолчанию выключено — сервис не выполняет ни одной git-команды.
# Токен нужен с правом записи (contents:write). Он не сохраняется в .git/config
# и не попадает в аргументы командной строки.
MEDIA_GIT_ENABLED=false
MEDIA_GIT_REPOSITORY_URL=https://github.com/RXDCODX/random-memes.git
MEDIA_GIT_BRANCH=master
# Имя пользователя для HTTP-аутентификации. Для GitHub classic-токенов
# обычно не требуется, оставьте пустым.
MEDIA_GIT_USERNAME=
MEDIA_GIT_TOKEN=

# ─── Хранилище медиа (MARS.MediaStorage) ─────────────────────────────────────
# Максимальный размер одного загружаемого файла, МБ. Держится ниже жёсткого
# лимита GitHub в 100 МБ: файл крупнее нельзя запушить, и он остался бы
# лежать на диске, ломая синхронизацию.
MEDIA_STORAGE__MAXUPLOAD_SIZEMB=95
# Сколько дней удалённый файл лежит в корзине до безвозвратного удаления.
MEDIA_STORAGE__TRASHRETENTIONDAYS=30

# ─── Прокси Telegram (tg-ws-proxy) ────────────────────────────────────────────
# Прокси, к которому подключается клиент Telegram вместо api.telegram.org:
# используется, когда прямой доступ к Telegram с машины владельца закрыт.
# Порт 1443 зашит в docker-compose.yml и в схему портов не входит — это
# единственная публикация боевого стенда рядом с Gateway.
# Секрет прокси: обязателен, иначе контейнер генерирует случайный при старте и
# настроить клиента по нему нельзя. Тот же секрет использует клиент WTelegram,
# поэтому хранится один раз — здесь.
TG_WS_PROXY_SECRET=
# Список адресов, которым прокси раздаёт доступ, через запятую.
TG_WS_PROXY_DC_IPS=4:149.154.167.220

# ─── Telegram (MARS.Telegram) ────────────────────────────────────────────────
# api_id и api_hash приложения с my.telegram.org. Без них бот не авторизуется по
# MTProto: прямой доступ к api.telegram.org с машины владельца закрыт, поэтому
# Bot API не работает и весь обмен идёт через прокси.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Телефон и пароль двухфакторной аутентификации пользовательского аккаунта —
# они нужны клиенту WTelegram (WClient), боту хватает токена. Секреты живут
# только в файле окружения: в профиль запуска они не попадают.
TELEGRAM_PHONE_NUMBER=
TELEGRAM_2FA_PASSWORD=
# Адрес MTProto-прокси для клиента. В контейнерах — имя службы compose, на хосте
# (F5) — localhost и опубликованный стендом порт, см. docker-compose.dev.yml.
TELEGRAM_PROXY_SERVER=
TELEGRAM_PROXY_PORT=1443
