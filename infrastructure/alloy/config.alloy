// Grafana Alloy: единственный путь логов в Loki.
//
// Схема была мёртвой: Loki был поднят в docker-compose, datasource на него
// провижинился в Grafana, но никто ничего в Loki не отправлял — promtail/Alloy
// не было, а «Loki:Url» в коде не читался ни одним обработчиком. Логи уходили
// только в Seq вторым, отдельным интерфейсом.
//
// Теперь у Alloy два источника, и оба кладут записи в один loki.write:
// приложения шлют логи сами по OTLP (порт 4317), а stdout читается у контейнеров
// без метки mars.logs=otlp — это инфраструктура (postgres, rabbitmq, loki,
// grafana) и всё, что логи по OTLP не отправляет. Приложения из stdout при этом
// исключены: иначе одна и та же строка попала бы в Loki дважды. Grafana
// становится единственным UI для метрик, логов и трейсов.

// Приём OTLP-логов от контейнеров: приложения шлют логи по gRPC (4317) в Alloy,
// Alloy разворачивает атрибуты в метки Loki и кладёт их в тот же receive.
otelcol.receiver.otlp "logs" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    logs = [otelcol.processor.attributes.mars_logs.input]
  }
}



otelcol.exporter.loki "default" {
  forward_to = [loki.write.mars.receiver]
}

// Подсказка loki.resource.labels: otelcol.exporter.loki превращает в метки
// Loki именно атрибуты ресурса, а подсказка loki.attribute.labels — атрибуты
// записи. Метку container кладёт ресурс (SerilogExtensions пишет его в
// ResourceAttributes), поэтому loki.attribute.labels не сработала бы: она искала
// бы атрибут записи, которого у записи нет, и метка container не появилась бы.
otelcol.processor.attributes "mars_logs" {
  action {
    key    = "loki.resource.labels"
    value  = "container"
    action = "insert"
  }

  action {
    key    = "mars.logs"
    action = "delete"
  }

  output {
    logs = [otelcol.exporter.loki.default.input]
  }
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

// Оставляем только контейнеры проекта mars. Без фильтра Alloy забрал бы логи
// всей машины: postgres, сам Alloy, grafana и прочий мусор. Это и лишняя
// нагрузка, и лишние лейблы, по которым потом приходится фильтровать руками.
discovery.relabel "mars" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "mars"
    action        = "keep"
  }

  // Compose даёт контейнерам имена вида «mars-twitch-core-1» (с префиксом
  // проекта и порядковым номером). Метка container используется в Grafana как
  // «{container=~"twitch-core|gateway|…"}», поэтому префикс и суффикс убираем.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/mars-(.*)-\\d+$"
    target_label  = "container"
  }

  // Приложения шлют логи сами по OTLP (метка mars.logs=otlp в якоре сервисов
  // docker-compose.yml), поэтому их строки из stdout не читаем: иначе каждая
  // запись попала бы в Loki дважды — как OTLP-запись и как строка контейнера.
  // У инфраструктуры (postgres, rabbitmq, loki, grafana) этой метки нет, и её
  // stdout остаётся единственным источником логов.
  rule {
    source_labels = ["__meta_docker_container_label_mars_logs"]
    regex         = "otlp"
    action        = "drop"
  }
}

loki.source.docker "mars" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.mars.output
  labels     = { project = "mars" }
  forward_to = [loki.write.mars.receiver]
}

loki.write "mars" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

