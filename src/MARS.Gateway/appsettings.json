        }
      },
      "discord": {
        "Destinations": {
          "destination1": { "Address": "http://discord:8080/" }
        }
      },
      "commands": {
        "Destinations": {
          "destination1": { "Address": "http://commands:8080/" }
        }
      },
      "sound-request": {
        "Destinations": {
          "destination1": { "Address": "http://sound-request:8080/" }
        }
      },
      "tts": {
        "Destinations": {
          "destination1": { "Address": "http://tts:8080/" }
        }
      },
      "obs": {
        "Destinations": {
          "destination1": { "Address": "http://obs:8080/" }
        }
      },
      "alerts": {
        "Destinations": {
          "destination1": { "Address": "http://alerts:8080/" }
        }
      },
      "scoreboard": {
        "Destinations": {
          "destination1": { "Address": "http://scoreboard:8080/" }
        }
      },
      "cinema-queue": {
        "Destinations": {
          "destination1": { "Address": "http://cinema-queue:8080/" }
        }
      },
      "media-storage": {
        "Destinations": {
          "destination1": { "Address": "http://media-storage:8080/" }
        }
      },
      "admin": {
        "Destinations": {
          "destination1": { "Address": "http://admin:8080/" }
        }
      }
    }
  },
  "ServiceAuth": {
    "ApiKey": "mars-dev-service-key"
