{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "//": "Предел тела запроса в байтах. Применяется до проксирования, поэтому загрузка файлов в хранилище (до 95 МБ) проходила только с увеличенным значением.",
    "MaxRequestBodyBytes": 268435456
  },
  "Yarp": {
    "Routes": {
      "twitch-core": {
        "ClusterId": "twitch-core",
        "Match": { "Path": "/api/Twitch/{**remainder}" }
      },
      "twitch-core-auth": {
        "ClusterId": "twitch-core",
        "Match": { "Path": "/api/TwitchAuth/{**remainder}" }
      },
      "twitch-core-users": {
        "ClusterId": "twitch-core",
        "Match": { "Path": "/api/TwitchUsers/{**remainder}" }
      },
      "twitch-core-rewards": {
        "ClusterId": "twitch-core",
        "Match": { "Path": "/api/ChannelRewardsManager/{**remainder}" }
      },
      "twitch-core-auto-messages": {
        "ClusterId": "twitch-core",
        "Match": { "Path": "/api/AutoMessages/{**remainder}" }
      },
      "twitch-core-stats": {
        "ClusterId": "twitch-core",
        "Match": { "Path": "/api/ServerStats/{**remainder}" }
      },
      "waifu-gacha": {
        "ClusterId": "waifu-gacha",
        "Match": { "Path": "/api/WaifuRoll/{**remainder}" }
      },
      "telegram": {
        "ClusterId": "telegram",
        "Match": { "Path": "/api/Telegram/{**remainder}" }
