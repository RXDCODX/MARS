        "ClusterId": "telegram",
        "Match": { "Path": "/api/WTelegram/{**remainder}" }
      },
      "telegram-google": {
        "ClusterId": "telegram",
        "Match": { "Path": "/api/GooglePhotos/{**remainder}" }
      },
      "telegram-clipboard-copy": {
        "ClusterId": "telegram",
        "Match": { "Path": "/api/TelegramClipboardCopy/{**remainder}" }
      },
      "telegram-discord-bridge": {
        "ClusterId": "telegram",
        "Match": { "Path": "/api/TelegramDiscordBridge/{**remainder}" }
      },
      "commands": {
        "ClusterId": "commands",
        "Match": { "Path": "/api/Commands/{**remainder}" }
      },
      "sound-request": {
        "ClusterId": "sound-request",
        "Match": { "Path": "/api/SoundRequest/{**remainder}" }
      },
      "spotify-auth": {
        "ClusterId": "sound-request",
        "Match": { "Path": "/api/SpotifyAuth/{**remainder}" }
      },
      "obs": {
        "ClusterId": "obs",
        "Match": { "Path": "/api/Obs/{**remainder}" }
      },
      "test-alerts": {
        "ClusterId": "obs",
        "Match": { "Path": "/api/TestAlerts/{**remainder}" }
      },
      "cinema-queue": {
        "ClusterId": "cinema-queue",
        "Match": { "Path": "/api/CinemaQueue/{**remainder}" }
      },
      "media-info": {
        "ClusterId": "media-storage",
        "Match": { "Path": "/api/MediaInfoApi/{**remainder}" }
      },
      "random-meme": {
        "ClusterId": "media-storage",
        "Match": { "Path": "/api/RandomMeme/{**remainder}" }
      },
      "media-storage": {
        "ClusterId": "media-storage",
        "Match": { "Path": "/api/MediaStorage/{**remainder}" }
      },
      "media-storage-ui": {
        "ClusterId": "media-storage",
        "Match": { "Path": "/storage-ui/{**remainder}" }
      },
      "pyro-alerts": {
        "ClusterId": "media-storage",
        "Match": { "Path": "/memory/{**remainder}" }
      },
      "discord": {
        "ClusterId": "discord",
        "Match": { "Path": "/api/Discord/{**remainder}" }
      },
      "admin-service-manager": {
        "ClusterId": "admin",
        "AuthorizationPolicy": "ServiceApiKey",
        "Match": { "Path": "/api/ServiceManager/{**remainder}" }
      },
      "admin-root-state": {
        "ClusterId": "admin",
        "AuthorizationPolicy": "ServiceApiKey",
        "Match": { "Path": "/api/RootState/{**remainder}" }
      },
      "admin-env-var": {
        "ClusterId": "admin",
        "AuthorizationPolicy": "ServiceApiKey",
        "Match": { "Path": "/api/EnvironmentVariable/{**remainder}" }
      },
      "admin-rxdcodx": {
        "ClusterId": "admin",
        "AuthorizationPolicy": "ServiceApiKey",
        "Match": { "Path": "/api/RxdcodxViewers/{**remainder}" }
      },
      "admin-archive": {
        "ClusterId": "admin",
        "AuthorizationPolicy": "ServiceApiKey",
        "Match": { "Path": "/api/StreamArchive/{**remainder}" }
      },
      "scoreboard": {
        "ClusterId": "scoreboard",
        "Match": { "Path": "/api/Scoreboard/{**remainder}" }
