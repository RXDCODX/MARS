{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Yarp": {
    "Routes": {
      "media-storage-hot-reload": {
        "ClusterId": "media-storage",
        "Order": 0,
        "Match": {
          "Path": "/_framework/{**remainder}"
        }
      }
    }
  }
}
