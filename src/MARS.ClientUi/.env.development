# Базис относительный: страница и API живут на одном origin за Gateway.
# Абсолютный порт здесь означал бы, что dev-сборка работает только при
# обращении с localhost.
VITE_BASE_PATH=/
VITE_API_BASE_URL=/
# Прозрачные логи SignalR в консоли браузера (попытки, negotiate, события).
VITE_SIGNALR_DEBUG=true