<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>MARS.Alerts</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <CSharpier_Bypass>true</CSharpier_Bypass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Telegram.Bot" />
    <PackageReference Include="SevenTV-lib" />
    <PackageReference Include="Ben.Demystifier" />
    <PackageReference Include="WTelegramClient" />
    <!-- mars_alerts: AdhdLayoutConfig. Конвейер 365 уехал в MARS.Videos365. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MARS.Shared\MARS.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Контракт имён методов оверлейного хаба. Встроен ресурсом, а не
         скопирован файлом: имя метода — строка на проводе, компилятор её не
         проверяет, и расхождение ловит тест. Так путь к контракту не зависит
         от того, как MSBuild раскладывает выходную папку. -->
    <EmbeddedResource Include="Hubs\overlay-hub.manifest.json" />
  </ItemGroup>
</Project>
