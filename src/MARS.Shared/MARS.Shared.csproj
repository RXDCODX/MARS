<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>MARS.Shared</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <CSharpier_Bypass>true</CSharpier_Bypass>
  </PropertyGroup>

  <ItemGroup>
    <!-- Тесты MARS.Shared.Tests проверяют внутренние хелперы, например
         нормализацию имён метрик в OpenTelemetryPrometheusBridge. -->
    <InternalsVisibleTo Include="MARS.Shared.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- OpenTelemetry (v1.17.0 — aligned) -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />

    <!-- gRPC: хост gRPC-сервисов и клиентские каналы -->
    <PackageReference Include="Grpc.AspNetCore" />

    <!-- Application Insights -->
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />

    <!-- Logging (Serilog v4) -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.AspNetCore" />
<PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />

    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />

    <!-- Metrics (Prometheus) -->
    <PackageReference Include="prometheus-net.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />

    <!-- HTTP Resilience (Polly v8) -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />

    <!-- EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Npgsql 10.0.3 приводит EF Relational 10.0.4, а EF Core в репозитории
         10.0.10. Без явной ссылки на Relational конфликт всплывает MSB3277 в
         каждом проекте, который ссылается на MARS.Shared. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />

    <!-- RabbitMQ v7 (async-first API) -->
    <PackageReference Include="RabbitMQ.Client" />

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi.Readers" />
  </ItemGroup>

  <ItemGroup>
    <!-- protoc для .proto из Protos: контракты всех gRPC-сервисов лежат в
         MARS.Shared, чтобы и сервер, и клиент генерировались из одного места. -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <Protobuf Include="Protos\*.proto" GrpcServices="Both" ProtoRoot="Protos" />
  </ItemGroup>

</Project>
