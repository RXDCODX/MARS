@model MARS.MediaStorage.Presentation.Storage.Pages.Storage.IndexModel

@if (Model.TrashEntries.Count == 0)
{
    <div class="empty-state">Корзина пуста.</div>
}
else
{
    <table class="file-table" data-resizable-columns>
        <colgroup>
            <col data-column="type" style="width:64px" />
            <col data-column="name" />
            <col data-column="size" style="width:76px" />
            <col data-column="deleted" style="width:118px" />
            <col data-column="path" style="width:170px" />
            <col data-column="actions" style="width:76px" />
        </colgroup>
        <thead>
            <tr>
                <th data-resize-column="type">Тип</th>
                <th data-resize-column="name">Имя</th>
                <th data-resize-column="size">Размер</th>
                <th data-resize-column="deleted">Удалён</th>
                <th data-resize-column="path">Оригинальный путь</th>
                <th data-resize-column="actions">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.SortedTrashEntries)
            {
                <tr>
                    <td class="type-cell">@Model.GetFileTypeName(entry.FileName)</td>
                    <td class="file-name-cell">
                        <span class="file-name-text" title="@entry.FileName">@IndexModel.GetFileDisplayName(entry.FileName)</span>
                    </td>
                    <td class="size-cell">@IndexModel.FormatBytes(entry.SizeBytes)</td>
                    <td class="date-cell">@IndexModel.FormatDate(entry.DeletedAt)</td>
                    <td class="path-cell">@entry.OriginalPath</td>
                    <td class="file-actions-cell">
                        <div class="row-actions">
                            <form method="post" asp-page-handler="Restore" class="row-action-form">
                                <partial name="Components/_FormState" model="Model" />
                                <input type="hidden" name="SelectedIds" value="@entry.Id" />
                                <button class="row-action" type="submit" title="Восстановить" aria-label="Восстановить @entry.FileName">↶</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
