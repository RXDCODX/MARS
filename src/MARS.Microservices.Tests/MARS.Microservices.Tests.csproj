<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RootNamespace>MARS.Microservices.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Testcontainers.PostgreSQL" Version="4.14.0" />
    <!-- Testcontainers тянет EF Relational 10.0.4, сервисы используют 10.0.10:
         без явного пинningа сборка падает с MSB3277. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Отдельный проект необходим, потому что существуют ДВА проекта с именем MARS.Shared:
    монолитный (MARS.Projects/MARS.Shared, на него ссылается MARS.Server) и
    микросервисный (MARS.Projects/MARS.Microservices/MARS.Shared). Оба собирают
    сборку MARS.Shared, поэтому MARS.Tests (который тянет монолит) не может
    дополнительно ссылаться на микросервисный без коллизии типов.
  -->
  <ItemGroup>
    <ProjectReference Include="..\MARS.Shared\MARS.Shared.csproj" />
    <ProjectReference Include="..\MARS.Admin\MARS.Admin.csproj" />
    <ProjectReference Include="..\MARS.Gateway\MARS.Gateway.csproj" />
    <ProjectReference Include="..\MARS.MediaStorage\MARS.MediaStorage.csproj" />
    <ProjectReference Include="..\MARS.WaifuGacha\MARS.WaifuGacha.csproj" />
    <ProjectReference Include="..\MARS.TwitchCore\MARS.TwitchCore.csproj" />
  </ItemGroup>

</Project>
