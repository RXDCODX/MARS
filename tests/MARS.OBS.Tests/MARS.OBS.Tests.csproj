<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit.v3: тест-проект сам является исполняемым файлом. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Moq" />
    <!-- Покрытие кода в CI: единственный сборщик, совместимый с MTP v2. -->
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MARS.OBS\MARS.OBS.csproj" />
    <!-- Общие проверки контракта публичной поверхности: без них каждая модель
         и DTO проверялись бы вручную, а именно на них приходится основная
         масса методов в знаменателе покрытия. -->
    <ProjectReference Include="..\MARS.TestKit\MARS.TestKit.csproj" />
  </ItemGroup>
</Project>
