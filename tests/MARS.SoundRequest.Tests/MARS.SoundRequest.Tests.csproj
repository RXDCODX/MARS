<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- xunit.v3: тест-проект сам является исполняемым файлом. -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MARS.SoundRequest.Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <CSharpier_Bypass>true</CSharpier_Bypass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Moq" />
    <!-- InMemory: StateManager пишет состояние плеера в свою БД, нативного кода
         провайдер не подтягивает. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!-- In-memory TestServer: gRPC проверяется настоящим GrpcChannel поверх
         CreateHandler(), потому что ServerCallContext в Grpc.Core.Api
         не mockается — все его члены не virtual. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- Покрытие кода в CI: единственный сборщик, совместимый с MTP v2. -->
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MARS.SoundRequest\MARS.SoundRequest.csproj" />
  </ItemGroup>

</Project>