<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit.v3: тест-проект сам является исполняемым файлом. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Moq" />
    <!-- In-memory TestServer: gRPC проверяется настоящим GrpcChannel поверх
         CreateHandler(), потому что ServerCallContext в Grpc.Core.Api
         не mockается — все его члены не virtual. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- Покрытие кода в CI: единственный сборщик, совместимый с MTP v2. -->
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MARS.Shared/MARS.Shared.Kernel/MARS.Shared.Kernel.csproj" />
    <ProjectReference Include="../../src/MARS.Shared/MARS.Shared.Contracts/MARS.Shared.Contracts.csproj" />
    <ProjectReference Include="../../src/MARS.Platform/MARS.Platform.Infrastructure.Messaging.RabbitMq/MARS.Platform.Infrastructure.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="../../src/MARS.Platform/MARS.Platform.Infrastructure.Persistence.Postgres/MARS.Platform.Infrastructure.Persistence.Postgres.csproj" />
    <ProjectReference Include="../../src/MARS.Platform/MARS.Platform.Infrastructure.Grpc/MARS.Platform.Infrastructure.Grpc.csproj" />
    <ProjectReference Include="../../src/MARS.Platform/MARS.Platform.Infrastructure.Observability.Logging/MARS.Platform.Infrastructure.Observability.Logging.csproj" />
    <ProjectReference Include="../../src/MARS.Platform/MARS.Platform.Infrastructure.Observability.Telemetry/MARS.Platform.Infrastructure.Observability.Telemetry.csproj" />
    <ProjectReference Include="../../src/MARS.Platform/MARS.Platform.Infrastructure.Web.AspNetCore/MARS.Platform.Infrastructure.Web.AspNetCore.csproj" />
    <ProjectReference Include="../../src/MARS.Platform/MARS.Platform.Infrastructure.Development/MARS.Platform.Infrastructure.Development.csproj" />
    <ProjectReference Include="../../src/MARS.Platform/MARS.Platform.Infrastructure.Hosting/MARS.Platform.Infrastructure.Hosting.csproj" />
    <ProjectReference Include="../../src/MARS.Platform/MARS.Platform.Infrastructure.Clients.Http/MARS.Platform.Infrastructure.Clients.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общие проверки контракта публичной поверхности сборки. -->
    <ProjectReference Include="..\MARS.TestKit\MARS.TestKit.csproj" />
  </ItemGroup>
</Project>
