<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit.v3: тест-проект сам является исполняемым файлом. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Moq" />
    <!-- In-memory TestServer: gRPC проверяется настоящим GrpcChannel поверх
         CreateHandler(), потому что ServerCallContext в Grpc.Core.Api
         не mockается — все его члены не virtual. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- Покрытие кода в CI: единственный сборщик, совместимый с MTP v2. -->
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MARS.Shared.Kernel/MARS.Shared.Kernel.csproj" />
    <ProjectReference Include="../../src/MARS.Shared.Contracts/MARS.Shared.Contracts.csproj" />
    <ProjectReference Include="../../src/MARS.Platform.Messaging.RabbitMq.Infrastructure/MARS.Platform.Messaging.RabbitMq.Infrastructure.csproj" />
    <ProjectReference Include="../../src/MARS.Platform.Persistence.Postgres.Infrastructure/MARS.Platform.Persistence.Postgres.Infrastructure.csproj" />
    <ProjectReference Include="../../src/MARS.Platform.Grpc.Infrastructure/MARS.Platform.Grpc.Infrastructure.csproj" />
    <ProjectReference Include="../../src/MARS.Platform.Observability.Logging.Infrastructure/MARS.Platform.Observability.Logging.Infrastructure.csproj" />
    <ProjectReference Include="../../src/MARS.Platform.Observability.Telemetry.Infrastructure/MARS.Platform.Observability.Telemetry.Infrastructure.csproj" />
    <ProjectReference Include="../../src/MARS.Platform.Web.AspNetCore.Infrastructure/MARS.Platform.Web.AspNetCore.Infrastructure.csproj" />
    <ProjectReference Include="../../src/MARS.Platform.Development.Infrastructure/MARS.Platform.Development.Infrastructure.csproj" />
    <ProjectReference Include="../../src/MARS.Platform.Hosting.Infrastructure/MARS.Platform.Hosting.Infrastructure.csproj" />
    <ProjectReference Include="../../src/MARS.Platform.Clients.Http.Infrastructure/MARS.Platform.Clients.Http.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общие проверки контракта публичной поверхности сборки. -->
    <ProjectReference Include="..\MARS.TestKit\MARS.TestKit.csproj" />
  </ItemGroup>
</Project>
