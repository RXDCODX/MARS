<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Не тестовый проект: здесь нет [Fact], только общие проверки, которые
         вызывают тесты сервисов. OutputType=Library, поэтому в матрицу tests
         в ci.yml его добавлять не нужно, а в MARS.slnx — нужно: иначе
         `dotnet build MARS.slnx` его не соберёт. -->
    <OutputType>Library</OutputType>
    <RootNamespace>MARS.TestKit</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <CSharpier_Bypass>true</CSharpier_Bypass>
  </PropertyGroup>

  <ItemGroup>
    <!-- Заглушки для DI в тестах: без них сервисы, которые ищут зависимости
         рефлексией (фабрика команд, воркеры), нечем собрать, не уводя тест
         в сеть. -->
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <!-- Обход фабрик контекста для scaffold-миграций. Версии те же, что в
         Directory.Packages.props, новых записей не появляется. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общая платформа ASP.NET Core: нужна только чтобы тестовые проекты и киты
         собирались с теми же Microsoft.Extensions.*, что и сервисы. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- PostgreSQL для тестов. Контейнер поднимает сам Testcontainers, поэтому
         отдельная база в репозитории не нужна: ни в compose стенда, ни в
         workflow. Фикстура в Postgres/ создаёт базу на тест из этого контейнера и
         применяет настоящие миграции сервиса. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Npgsql напрямую: фикстура создаёт и удаляет базы (CREATE/DROP DATABASE),
         а это делается сырым SQL, вне EF. -->
    <PackageReference Include="Npgsql" />
    <!-- Провайдер EF: фабрика отдаёт контексты, собранные на UseNpgsql, иначе
         тесты проверяли бы модель, а не PostgreSQL. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- IAsyncLifetime фикстуры: берём extensibility.core, а не xunit.v3 —
         MARS.TestKit библиотека, а не тестовый проект, и xunit.v3 требует
         OutputType=Exe. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
</Project>
