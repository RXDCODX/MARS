<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Не тестовый проект: здесь нет [Fact], только общие проверки, которые
         вызывают тесты сервисов. OutputType=Library, поэтому в матрицу tests
         в ci.yml его добавлять не нужно, а в MARS.slnx — нужно: иначе
         `dotnet build MARS.slnx` его не соберёт. -->
    <OutputType>Library</OutputType>
    <RootNamespace>MARS.TestKit</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);xUnit1051</WarningsAsErrors>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <CSharpier_Bypass>true</CSharpier_Bypass>
  </PropertyGroup>

  <ItemGroup>
    <!-- Заглушки для DI в тестах: без них сервисы, которые ищут зависимости
         рефлексией (фабрика команд, воркеры), нечем собрать, не уводя тест
         в сеть. -->
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общая платформа ASP.NET Core: нужна только чтобы тестовые проекты и киты
         собирались с теми же Microsoft.Extensions.*, что и сервисы. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
