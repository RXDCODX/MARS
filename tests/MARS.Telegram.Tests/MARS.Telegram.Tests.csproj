<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit.v3: тест-проект сам является исполняемым файлом. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Moq" />
    <!-- Настоящий TestServer для проверки gRPC-сервиса: подменённый HttpHandler
         единственным способом говорит правду о маршрутизации и статусах. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!-- Покрытие кода в CI: единственный сборщик, совместимый с MTP v2. -->
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MARS.Telegram\MARS.Telegram.csproj" />
    <ProjectReference Include="..\..\src\MARS.Telegram.Api.Rest\MARS.Telegram.Api.Rest.csproj" />
    <ProjectReference Include="..\..\src\MARS.Telegram.Api.Grpc\MARS.Telegram.Api.Grpc.csproj" />
    <ProjectReference Include="..\..\src\MARS.Telegram.Domain\MARS.Telegram.Domain.csproj" />
    <ProjectReference Include="..\..\src\MARS.Telegram.Application\MARS.Telegram.Application.csproj" />
    <ProjectReference Include="..\..\src\MARS.Telegram.Infrastructure.Persistence.Postgres\MARS.Telegram.Infrastructure.Persistence.Postgres.csproj" />
    <ProjectReference Include="..\..\src\MARS.Telegram.Infrastructure.Integrations.Telegram\MARS.Telegram.Infrastructure.Integrations.Telegram.csproj" />
    <ProjectReference Include="..\..\src\MARS.Telegram.Infrastructure.Integrations.GooglePhotos\MARS.Telegram.Infrastructure.Integrations.GooglePhotos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Общие проверки контракта публичной поверхности сборки. -->
    <ProjectReference Include="..\MARS.TestKit\MARS.TestKit.csproj" />
  </ItemGroup>
</Project>
