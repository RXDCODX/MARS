{
  "stryker-config": {
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "concurrency": 1,
    "mutation-level": "Standard",
    "additional-timeout": 30000,
    "mutate": [
      "**/*.cs",
      "!**/Migrations/**",
      "!**/Program.cs",
      "!**/*.g.cs",
      "!**/*.Designer.cs",
      "!**/obj/**",
      "!**/Protos/**"
    ],
    "ignore-methods": [
      "*.LogTrace",
      "*.LogDebug",
      "*.LogInformation",
      "*.LogWarning",
      "*.LogError",
      "*.LogCritical",
      "Log.*",
      "ConfigureAwait",
      "*Exception.ctor",
      "Console.Write*",
      "Debug.*",
      "Trace.*"
    ],
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "verbosity": "info"
  }
}
